[Unit]
Description=SmartShop Insight Course Project
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/smartshop
ExecStart=/usr/bin/python3 /opt/smartshop/app.py --host 0.0.0.0 --port 18080
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
User=smartshop
Group=smartshop
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/smartshop/data

[Install]
WantedBy=multi-user.target
